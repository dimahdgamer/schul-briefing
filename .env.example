# ── Image von GitHub ────────────────────────────────────────────────
# Wird automatisch richtig ausgefüllt, wenn die Datei aus dem Image kommt
IMAGE=ghcr.io/DEIN-GITHUB-NAME/schul-briefing:latest

# ── Schulmanager-Zugang (dein Schülerkonto) ─────────────────────────
SM_EMAIL=
SM_PASSWORD=

# ── Dashboard ───────────────────────────────────────────────────────
# Passwort, mit dem du dich in der App anmeldest (frei wählbar, lang)
APP_PASSWORD=

# Öffentliche Adresse der App (für Kalender-Links und sichere Cookies)
PUBLIC_URL=https://schule.gayjetlag.de

# Kontaktadresse für die Push-Dienste (Google/Apple/Mozilla), Pflicht für Web Push
VAPID_SUBJECT=mailto:deine-adresse@example.org

# ── Sonstiges ───────────────────────────────────────────────────────
# Bundesland für Ferien und Feiertage (NRW = DE-NW)
HOLIDAY_SUBDIVISION=DE-NW
TZ=Europe/Berlin

# Port auf dem Pi, an den Cloudflare bzw. nginx weiterleitet (nur 127.0.0.1)
APP_PORT=8470

# 1 = Testdaten statt echtem Schulmanager-Konto
DEMO_MODE=0
